# ==========================================
# Projeto: Feeder
# Arquivo de Exemplo de Variáveis de Ambiente
# ==========================================

# ------------------------------------------
# Configurações da Aplicação (Backend)
# ------------------------------------------
NODE_ENV=development
PORT=3000

# ------------------------------------------
# Configurações do Banco de Dados (MySQL)
# Utilizadas tanto pelo Docker Compose quanto pelo NestJS (TypeORM)
# ------------------------------------------
DB_HOST=localhost # No Docker, o backend enxerga 'mysql'. Rodando o Node direto, é 'localhost'
DB_PORT=3306
DB_ROOT_PASSWORD=rootpassword
DB_NAME=feeder
DB_USER=feederuser
DB_PASSWORD=feederpassword

# ------------------------------------------
# Configurações do Redis (BullMQ / Caching)
# ------------------------------------------
REDIS_HOST=localhost # No Docker é 'redis'
REDIS_PORT=6379

# ------------------------------------------
# Autenticação e JWT
# ------------------------------------------
JWT_SECRET=sua_chave_secreta_super_segura
JWT_EXPIRATION=1d

# ------------------------------------------
# WebAuthn / Passkeys (SimpleWebAuthn)
# ------------------------------------------
RP_NAME="Feeder App"
RP_ID=localhost
ORIGIN=http://localhost:4200

# ------------------------------------------
# Tools (docker-compose.tools.yml)
# ------------------------------------------
PHPMYADMIN_PORT=8080
REDISCOMMANDER_PORT=8081
