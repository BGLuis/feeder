{
	"$schema": "https://json.schemastore.org/swcrc",
	"jsc": {
		"parser": {
			"syntax": "typescript",
			"decorators": true,
			"dynamicImport": true
		},
		"transform": {
			"legacyDecorator": true,
			"decoratorMetadata": true
		},
		"target": "es2023",
		"keepClassNames": true,
		"baseUrl": "./",
		"paths": {
			"@/*": ["src/*"]
		}
	},
	"module": {
		"type": "commonjs"
	},
	"exclude": [
		"node_modules",
		"dist",
		"\\.spec\\.ts$",
		"src/scraping/scripts/.*\\.js$"
	]
}
